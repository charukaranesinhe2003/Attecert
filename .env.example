APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
APP_KEY=change-this-to-a-long-random-string
APP_TIMEZONE=Asia/Colombo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attecert
DB_USERNAME=attecert
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@attecert.lk
MAIL_FROM_NAME=AtteCert

UPLOAD_MAX_MB=10

# Customer verification by one-time email or SMS code
CUSTOMER_OTP_REQUIRED=true

# SMSlenz: enter the real credentials from your SMSlenz account
SMSLENZ_BASE_URL=https://smslenz.lk/api
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=AtteCert
SMSLENZ_TIMEOUT=15

# Custom SMTP account (MAIL_HOST/PORT/USERNAME/PASSWORD/ENCRYPTION above)
MAIL_TIMEOUT=30
MAIL_MAX_ATTEMPTS=3
PUBLIC_OTP_REQUIRED=true
