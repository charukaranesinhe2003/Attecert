# Serve the site from public/ when the project folder is opened in XAMPP.
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect private paths before allowing requests through to public/.
    RewriteRule (^|/)\.(env|git) - [F,L,NC]
    RewriteRule ^(app|bootstrap|cli|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Directory-relative matching also works when installed in a subfolder.
    RewriteRule ^public(/|$) - [L]
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
